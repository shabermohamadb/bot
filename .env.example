# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=optional_test_guild_id

# Database Configuration
# For SQLite (default for development/testing):
DATABASE_PATH=./data/raid-master.db
DATABASE_URL="file:./data/raid-master.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://username:password@localhost:5432/raidmaster?schema=public"

# Bot Behavior & Permissions
BOT_PREFIX="!"
BOT_NAME_ALIAS="Raid master"
BOT_ALIAS_ENABLED=false
ORGANIZER_ROLE_IDS=""
LOG_LEVEL="info"
