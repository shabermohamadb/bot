# Discord Bot & Application Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_CLIENT_SECRET=optional_oauth_secret
DISCORD_REDIRECT_URI=https://your-app.onrender.com/auth/callback

# Neon Lakebase Postgres (Pooled for app traffic, Unpooled for migrations)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Realtime
NEON_REALTIME_URL=wss://ep-sample.rt.c-7.us-east-2.aws.neon.tech/
NEON_REALTIME_SECRET=nrt_live_sample_secret_key

# Web Server & Deployment Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SERVER_TIMEZONE=UTC
APP_BASE_URL=https://your-app.onrender.com

# Bot Customization
BOT_PREFIX=!
BOT_NAME_ALIAS="Raid master"
BOT_ALIAS_ENABLED=false
ORGANIZER_ROLE_IDS=
LOG_LEVEL=info
